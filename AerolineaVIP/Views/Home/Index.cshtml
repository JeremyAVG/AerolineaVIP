@using AerolineaVIP.Models
@model HomeIndexViewModel
@{
    ViewBag.Title = "Inicio";
}

<section class="portada-vip mb-4" aria-labelledby="tituloPortada">
    <h1 id="tituloPortada" class="display-5 fw-bold">Vuela a tu próximo destino</h1>
    <hr class="linea-dorada my-3" />
    <p class="lead mb-0">Viajes privados con atención personalizada en nuestra flota de jets Embraer Phenom 300E, con solo siete asientos por vuelo.</p>
    @if (!Request.IsAuthenticated)
    {
        <div class="mt-4 d-flex flex-wrap gap-2">
            @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "btn btn-outline-light" })
            @Html.ActionLink("Registrarse", "Register", "Account", null, new { @class = "btn btn-dorado" })
        </div>
    }
</section>

<section class="card tarjeta-busqueda mb-4" aria-labelledby="tituloBusqueda">
    <div class="card-body p-4">
        <h2 id="tituloBusqueda" class="h4 mb-3">Encuentra tu vuelo</h2>
        @Html.Partial("_FormularioBusqueda", Model.Busqueda)
        <p class="text-muted small mt-3 mb-0">Horarios sujetos a la programación establecida y disponibilidad real.</p>
    </div>
</section>

<section aria-labelledby="tituloDestinos">
    <h2 id="tituloDestinos" class="h4 mb-3">Destinos desde @Model.CiudadOrigen</h2>
    @if (!Model.Destinos.Any())
    {
        <div class="alert alert-info" role="status">Sin destinos disponibles por el momento.</div>
    }
    <div class="row g-3">
        @foreach (var destino in Model.Destinos)
        {
            <div class="col-12 col-md-4">
                <div class="card tarjeta-destino">
                    <div class="card-body">
                        <h3 class="h5 card-title mb-1">@destino.Ciudad <span class="codigo">(@destino.CodigoIATA)</span></h3>
                        @if (destino.TieneEscala)
                        {
                            <p class="small text-muted mb-2">Con escala en @destino.Escala</p>
                        }
                        <p class="mb-0"><strong>Opera:</strong> @destino.DiasTexto</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/busqueda-vuelos.js"></script>
}
