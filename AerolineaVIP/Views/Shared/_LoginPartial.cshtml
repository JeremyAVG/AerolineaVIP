@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm", @class = "d-flex align-items-lg-center" }))
    {
        @Html.AntiForgeryToken()
        <ul class="navbar-nav">
            <li class="nav-item">
                @Html.ActionLink("Hola " + User.Identity.GetUserName() + "!", "Index", "Manage", new { area = "" }, new { title = "Mi cuenta", @class = "nav-link" })
            </li>
            <li class="nav-item">
                <button type="submit" class="btn btn-link nav-link">Cerrar sesión</button>
            </li>
        </ul>
    }
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">@Html.ActionLink("Iniciar sesión", "Login", "Account", new { area = "" }, new { id = "loginLink", @class = "nav-link" })</li>
        <li class="nav-item">@Html.ActionLink("Registrarse", "Register", "Account", new { area = "" }, new { id = "registerLink", @class = "btn btn-dorado ms-lg-2" })</li>
    </ul>
}
