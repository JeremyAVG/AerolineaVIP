@using AerolineaVIP.Models
@model BusquedaVuelosViewModel

@using (Html.BeginForm("Resultados", "Vuelos", new { area = "" }, FormMethod.Get, new { id = "formBusqueda", role = "search" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger", role = "alert" })
    <div class="row g-3 align-items-start">
        <div class="col-12 col-md-6 col-lg-3">
            @Html.LabelFor(m => m.OrigenId, new { @class = "form-label" }) *
            @Html.DropDownListFor(m => m.OrigenId, Model.Origenes, "Seleccionar origen", new { @class = "form-select", data_url_destinos = Url.Action("Destinos", "Vuelos", new { area = "" }) })
            @Html.ValidationMessageFor(m => m.OrigenId, "", new { @class = "text-danger" })
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            @Html.LabelFor(m => m.DestinoId, new { @class = "form-label" }) *
            @Html.DropDownListFor(m => m.DestinoId, Model.Destinos, "Seleccionar destino", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.DestinoId, "", new { @class = "text-danger" })
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            @Html.LabelFor(m => m.Fecha, new { @class = "form-label" }) *
            @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.Fecha, "", new { @class = "text-danger" })
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            @Html.LabelFor(m => m.Pasajeros, new { @class = "form-label" }) *
            @Html.TextBoxFor(m => m.Pasajeros, new { @class = "form-control", type = "number", min = "1", max = "7" })
            <div class="form-text">De 1 a 7 pasajeros.</div>
            @Html.ValidationMessageFor(m => m.Pasajeros, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="mt-3 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-dorado px-4" id="btnBuscar">Buscar vuelos</button>
        @Html.ActionLink("Limpiar filtros", "Buscar", "Vuelos", new { area = "" }, new { @class = "btn btn-outline-secondary" })
    </div>
}
