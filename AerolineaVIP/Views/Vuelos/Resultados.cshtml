@using AerolineaVIP.Models
@model BusquedaVuelosViewModel
@{
    ViewBag.Title = "Resultados de vuelos";
}

<h1 class="h2 mb-3">@ViewBag.Title</h1>

<div class="filtros-vip mb-3">
    <strong>@ViewBag.Origen → @ViewBag.Destino</strong>
    · @Html.DisplayFor(m => m.Fecha)
    · @Model.Pasajeros pasajero(s)
</div>

<div class="alert alert-info" role="status">
    Los criterios de búsqueda son válidos. La lista de vuelos y horarios (pantalla 6) se implementa en la siguiente fase.
</div>

@Html.ActionLink("Nueva búsqueda", "Buscar", null, new { @class = "btn btn-outline-secondary" })
