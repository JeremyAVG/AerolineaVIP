@using AerolineaVIP.Models
@model ResultadosCompra
@{
    ViewBag.Title = "Resultados de vuelos";
}

<h1 class="h2 mb-3">@ViewBag.Title</h1>

<p>Tarifas en USD por pasajero. Los domingos se venden únicamente itinerarios completos de ida o regreso.</p>
@if (Model.Opciones.Count == 0) { <div class="alert alert-info">No hay vuelos disponibles para estos criterios.</div> }
<div class="row g-3">
@foreach (var opcion in Model.Opciones) {
    <div class="col-lg-6">@Html.Partial("_TarjetaVuelo", opcion)</div>
}
</div>

@Html.ActionLink("Nueva búsqueda", "Buscar", null, new { @class = "btn btn-outline-secondary" })
