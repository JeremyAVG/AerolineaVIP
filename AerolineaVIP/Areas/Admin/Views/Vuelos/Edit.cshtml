@using AerolineaVIP.Models
@model Vuelo
@{
    ViewBag.Title = "Asignar aeronave y estado";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>

<div class="row g-4">
    <div class="col-12 col-md-5">
        <div class="filtros-vip">
            <h2 class="h6">Vuelo @Model.CodigoVuelo</h2>
            <dl class="row mb-0 small">
                <dt class="col-5">Fecha</dt>
                <dd class="col-7">@Html.DisplayFor(m => m.FechaOperacion) (@Model.Frecuencia.NombreDiaSemana)</dd>
                <dt class="col-5">Ruta</dt>
                <dd class="col-7">@Model.Frecuencia.Ruta.Descripcion</dd>
                <dt class="col-5">Horario</dt>
                <dd class="col-7">@Model.Frecuencia.Horario</dd>
                <dt class="col-5">Aeronave vigente</dt>
                <dd class="col-7">@Model.AeronaveTexto</dd>
            </dl>
        </div>
    </div>
    <div class="col-12 col-md-7 col-lg-5">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            if (ViewBag.Rechazado == true)
            {
                <div class="alert alert-warning mb-2" role="alert">
                    <strong>Conflicto operativo:</strong> la asignación no se guardó y se conserva la asignación vigente.
                </div>
            }
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
            @Html.HiddenFor(m => m.VueloId)

            <div class="mb-3">
                @Html.LabelFor(m => m.AeronaveId, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.AeronaveId, (SelectList)ViewBag.ListaAeronaves, "Sin asignar", new { @class = "form-select" })
                <div class="form-text">Solo se listan aeronaves disponibles. Sin aeronave el vuelo no se comercializa (RNP-01).</div>
                @Html.ValidationMessageFor(m => m.AeronaveId, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.EstadoVueloCodigo, new { @class = "form-label" }) *
                @Html.DropDownListFor(m => m.EstadoVueloCodigo, (SelectList)ViewBag.ListaEstados, new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.EstadoVueloCodigo, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
