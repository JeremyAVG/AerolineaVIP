@using AerolineaVIP.Models
@model Frecuencia
@{
    ViewBag.Title = "Detalle de frecuencia";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>

<dl class="row">
    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.RutaId)</dt>
    <dd class="col-sm-8">@Model.Ruta.Descripcion</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DiaSemana)</dt>
    <dd class="col-sm-8">@Model.NombreDiaSemana</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.HoraSalida)</dt>
    <dd class="col-sm-8">@Html.DisplayFor(m => m.HoraSalida)</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.HoraLlegada)</dt>
    <dd class="col-sm-8">@Html.DisplayFor(m => m.HoraLlegada)</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Activa)</dt>
    <dd class="col-sm-8">@Html.DisplayFor(m => m.Activa)</dd>
</dl>

<p>
    @Html.ActionLink("Editar", "Edit", new { id = Model.FrecuenciaId }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</p>
