@using AerolineaVIP.Models
@model IEnumerable<Frecuencia>
@{
    ViewBag.Title = "Frecuencias";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Nueva frecuencia", "Create", null, new { @class = "btn btn-dorado" })</p>

@using (Html.BeginForm("Index", "Frecuencias", FormMethod.Get, new { @class = "filtros-vip row g-2 align-items-end mb-3" }))
{
    <div class="col-12 col-md-6">
        <label class="form-label" for="rutaId">Ruta</label>
        @Html.DropDownList("rutaId", (SelectList)ViewBag.ListaRutas, "Todas", new { @class = "form-select" })
    </div>
    <div class="col-12 col-md-3">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
}

<div class="table-responsive">
<table class="table table-striped table-hover align-middle tabla-vip">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(m => m.RutaId)</th>
            <th scope="col">@Html.DisplayNameFor(m => m.DiaSemana)</th>
            <th scope="col">Horario</th>
            <th scope="col">@Html.DisplayNameFor(m => m.Activa)</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Ruta.Descripcion</td>
            <td>@item.NombreDiaSemana</td>
            <td>@item.Horario</td>
            <td>@Html.DisplayFor(m => item.Activa)</td>
            <td class="text-nowrap">
                @Html.ActionLink("Editar", "Edit", new { id = item.FrecuenciaId }) |
                @Html.ActionLink("Detalles", "Details", new { id = item.FrecuenciaId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.FrecuenciaId })
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No hay registros que coincidan.</div>
}
