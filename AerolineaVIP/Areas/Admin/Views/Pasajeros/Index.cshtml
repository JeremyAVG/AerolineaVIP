@using AerolineaVIP.Models
@model IEnumerable<Pasajero>
@{
    ViewBag.Title = "Pasajeros";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Nuevo pasajero", "Create", null, new { @class = "btn btn-dorado" })</p>

@using (Html.BeginForm("Index", "Pasajeros", FormMethod.Get, new { @class = "filtros-vip row g-2 align-items-end mb-3" }))
{
    <div class="col-12 col-md-6">
        <label class="form-label" for="buscar">Buscar por documento, nombres o apellidos</label>
        @Html.TextBox("buscar", (string)ViewBag.Buscar, new { @class = "form-control" })
    </div>
    <div class="col-12 col-md-3">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
}

<div class="table-responsive">
<table class="table table-striped table-hover align-middle tabla-vip">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(m => m.TipoDocumentoCodigo)</th>
            <th scope="col">@Html.DisplayNameFor(m => m.NumeroDocumento)</th>
            <th scope="col">Nombre completo</th>
            <th scope="col">@Html.DisplayNameFor(m => m.Correo)</th>
            <th scope="col">@Html.DisplayNameFor(m => m.Telefono)</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TipoDocumentoIdentidad.Descripcion</td>
            <td>@Html.DisplayFor(m => item.NumeroDocumento)</td>
            <td>@item.NombreCompleto</td>
            <td>@Html.DisplayFor(m => item.Correo)</td>
            <td>@Html.DisplayFor(m => item.Telefono)</td>
            <td class="text-nowrap">
                @Html.ActionLink("Editar", "Edit", new { id = item.PasajeroId }) |
                @Html.ActionLink("Detalles", "Details", new { id = item.PasajeroId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.PasajeroId })
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No hay registros que coincidan.</div>
}
