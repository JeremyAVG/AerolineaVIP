@using AerolineaVIP.Models
@model ReporteComprasViewModel
@{
    ViewBag.Title = "Consultas y reportes";
    ViewBag.Pestana = "compras";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>
@Html.Partial("_MenuReportes")

@using (Html.BeginForm("Compras", "Reportes", FormMethod.Get, new { @class = "filtros-vip row g-2 align-items-end mb-3" }))
{
    <div class="col-6 col-md-3">
        @Html.LabelFor(m => m.Desde, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Desde, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>
    <div class="col-6 col-md-3">
        @Html.LabelFor(m => m.Hasta, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Hasta, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>
    <div class="col-12 col-md-3">
        @Html.LabelFor(m => m.EstadoCompra, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.EstadoCompra, (SelectList)ViewBag.ListaEstados, "Todos", new { @class = "form-select" })
    </div>
    <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
}

<p class="small text-muted mb-2">
    Fecha de corte: <strong>@Model.FechaCorte.ToString("dd/MM/yyyy HH:mm")</strong>.
    Todos los pagos son simulados con fines académicos; no representan cobros reales.
</p>

<h2 class="h5">Resumen de pagos simulados por estado</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped tabla-vip">
        <thead>
            <tr>
                <th scope="col">Estado</th>
                <th scope="col">Descripción</th>
                <th scope="col" class="text-end">Pagos</th>
                <th scope="col" class="text-end">Total (USD)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in Model.ResumenPagos)
            {
                <tr>
                    <td>@fila.Codigo</td>
                    <td>@fila.Descripcion</td>
                    <td class="text-end">@fila.Cantidad</td>
                    <td class="text-end">@fila.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5">Compras</h2>
@if (!Model.Compras.Any())
{
    <div class="alert alert-info" role="status">No hay compras que coincidan con los filtros seleccionados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle tabla-vip">
            <thead>
                <tr>
                    <th scope="col">Compra</th>
                    <th scope="col">Reserva</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Importe</th>
                    <th scope="col" class="text-end">Aprobado</th>
                    <th scope="col">Pagos simulados</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var compra in Model.Compras)
                {
                    <tr>
                        <td>@compra.CompraId</td>
                        <td>@compra.Reserva.CodigoReserva</td>
                        <td>@compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@compra.EstadoCompra.Descripcion</td>
                        <td class="text-end">@compra.MonedaCodigo @compra.Importe.ToString("N2")</td>
                        <td class="text-end">@compra.TotalAprobado.ToString("N2")</td>
                        <td>
                            @foreach (var pago in compra.Pagoes)
                            {
                                <div class="small">@pago.CodigoOperacion · @pago.MarcaTarjeta.Nombre **** @pago.UltimosCuatroDigitos · @pago.EstadoPago.Descripcion</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4">Total (@Model.Compras.Count compras)</td>
                    <td class="text-end">@Model.TotalCompras.ToString("N2")</td>
                    <td class="text-end">@Model.TotalAprobado.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
