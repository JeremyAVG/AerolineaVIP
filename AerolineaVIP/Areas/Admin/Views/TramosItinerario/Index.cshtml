@using AerolineaVIP.Models
@model IEnumerable<TramoItinerario>
@{
    ViewBag.Title = "Tramos de itinerario";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Nuevo tramo", "Create", null, new { @class = "btn btn-dorado" })</p>

@using (Html.BeginForm("Index", "TramosItinerario", FormMethod.Get, new { @class = "filtros-vip row g-2 align-items-end mb-3" }))
{
    <div class="col-12 col-md-6">
        <label class="form-label" for="itinerarioId">Itinerario</label>
        @Html.DropDownList("itinerarioId", (SelectList)ViewBag.ListaItinerarios, "Todos", new { @class = "form-select" })
    </div>
    <div class="col-12 col-md-3">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
}

<div class="table-responsive">
<table class="table table-striped table-hover align-middle tabla-vip">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(m => m.ItinerarioId)</th>
            <th scope="col">@Html.DisplayNameFor(m => m.Orden)</th>
            <th scope="col">@Html.DisplayNameFor(m => m.VueloId)</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Itinerario.Referencia</td>
            <td>@Html.DisplayFor(m => item.Orden)</td>
            <td>@item.Vuelo.Descripcion</td>
            <td class="text-nowrap">
                @Html.ActionLink("Editar", "Edit", new { id = item.TramoItinerarioId }) |
                @Html.ActionLink("Detalles", "Details", new { id = item.TramoItinerarioId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.TramoItinerarioId })
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No hay registros que coincidan.</div>
}
