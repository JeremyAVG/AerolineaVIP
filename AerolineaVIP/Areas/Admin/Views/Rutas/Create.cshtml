@using AerolineaVIP.Models
@model Ruta
@{
    ViewBag.Title = "Nueva ruta";
}

@Html.Partial("_MenuAdmin")
<h1 class="h3 mb-3">@ViewBag.Title</h1>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

        <div class="mb-3">
            @Html.LabelFor(m => m.AeropuertoOrigenId, new { @class = "form-label" }) *
            @Html.DropDownListFor(m => m.AeropuertoOrigenId, (SelectList)ViewBag.ListaOrigen, "Seleccione el origen", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.AeropuertoOrigenId, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.AeropuertoDestinoId, new { @class = "form-label" }) *
            @Html.DropDownListFor(m => m.AeropuertoDestinoId, (SelectList)ViewBag.ListaDestino, "Seleccione el destino", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.AeropuertoDestinoId, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.TarifaReferencial, new { @class = "form-label" }) *
            @Html.TextBoxFor(m => m.TarifaReferencial, new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.TarifaReferencial, "", new { @class = "text-danger" })
        </div>
        <div class="form-check mb-3">
            @Html.CheckBoxFor(m => m.Activa, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.Activa, new { @class = "form-check-label" })
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
    }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
